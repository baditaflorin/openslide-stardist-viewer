#!/usr/bin/env bash
# Docs-only commits (just CLAUDE.md, the fleet-wide canonical doc sync)
# skip the full check suite below — it has nothing to check.
if [ "$(git diff --cached --name-only)" = "CLAUDE.md" ]; then
  exit 0
fi
set -euo pipefail

npm run lint
npm run format:check
npm run typecheck

if [[ -x ".venv/bin/ruff" ]]; then
  (cd backend && ../.venv/bin/ruff check .)
else
  echo "backend ruff not found; run make backend-venv"
  exit 1
fi

if command -v gitleaks >/dev/null 2>&1; then
  gitleaks protect --staged --redact
else
  echo "gitleaks is required for pre-commit secret scanning"
  exit 1
fi
