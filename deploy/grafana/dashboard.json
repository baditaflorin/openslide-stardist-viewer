{
  "title": "OpenSlide StarDist Viewer",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "title": "HTTP Requests",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(http_requests_total[5m])) by (status)"
        }
      ]
    },
    {
      "title": "Tile Requests",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum(rate(slide_tile_requests_total[5m]))"
        }
      ]
    },
    {
      "title": "Segmentation Latency",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(segmentation_duration_seconds_bucket[5m])) by (le, method))"
        }
      ]
    }
  ]
}
